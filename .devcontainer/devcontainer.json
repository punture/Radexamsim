// Private test copy of Exam Sim in GitHub Codespaces: fictional fixtures only, testing mode on.
// Nothing from the owner's quarantine, database or case storage belongs here.
// See docs/runbooks/CODESPACES.md.
{
  "name": "Exam Sim (private test copy)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "containerEnv": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  // Once, when the codespace is created: PostgreSQL 16, pnpm and the workspace packages.
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // At every start: write this codespace's .env, then start the database, API, worker and website.
  "postStartCommand": "bash .devcontainer/start.sh",
  // Whenever the editor connects: follow the app log. GitHub counts terminal output as activity,
  // so the codespace stays awake while the site is in use and the editor tab is open.
  "postAttachCommand": "bash .devcontainer/logs.sh",
  "portsAttributes": {
    "3000": { "label": "Exam Sim (keep private)", "onAutoForward": "openBrowser" }
  },
  // The API (4000) and PostgreSQL (5432) are reached only through the website.
  "otherPortsAttributes": { "onAutoForward": "ignore" }
}
