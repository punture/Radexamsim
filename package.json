{
  "name": "neuro-oral-exam-simulator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "vitest run",
    "test:s3": "bash scripts/test-s3.sh",
    "test:watch": "vitest",
    "db:start": "node scripts/platform.mjs dev-db start",
    "db:stop": "node scripts/platform.mjs dev-db stop",
    "db:migrate": "pnpm --filter @sim/db run migrate",
    "db:seed": "pnpm --filter @sim/api run seed",
    "dev": "node scripts/platform.mjs dev",
    "dev:api": "pnpm --filter @sim/api run dev",
    "dev:worker": "pnpm --filter @sim/worker run dev",
    "dev:web": "pnpm --filter @sim/web run dev",
    "build": "pnpm -r run build",
    "e2e": "pnpm --filter @sim/web run e2e",
    "evals": "pnpm --filter @sim/evals run evals",
    "check:leaks": "node scripts/check-client-bundle-leaks.mjs",
    "evals:lock": "pnpm --filter @sim/evals run evals:lock",
    "evals:blind": "pnpm --filter @sim/evals run evals:blind",
    "evals:import-ratings": "pnpm --filter @sim/evals run evals:import-ratings",
    "intake": "node scripts/platform.mjs intake"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@sim/db": "workspace:*"
  }
}
